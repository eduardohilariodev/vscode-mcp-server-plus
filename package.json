{
  "name": "vscode-mcp-server-plus",
  "icon": "media/logo.png",
  "displayName": "VSCode MCP Server Plus",
  "description": "Enhanced VS Code MCP server with 40+ tools: file ops, git, tasks, terminals, refactoring, debugging, config, extensions, and clipboard",
  "version": "1.0.0",
  "repository": "https://github.com/eduardohilariodev/vscode-mcp-server-plus",
  "publisher": "eduardohilariodev",
  "license": "MIT",
  "engines": {
    "vscode": "^1.99.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "copilot",
    "claude",
    "cursor",
    "augment",
    "tools",
    "git",
    "terminal",
    "debug"
  ],
  "categories": [
    "Other",
    "Programming Languages",
    "Debuggers"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": ["terminalDataWriteEvent"],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "MCP Server",
      "properties": {
        "vscode-mcp-server.port": {
          "type": "number",
          "default": 3000,
          "minimum": 1024,
          "maximum": 65535,
          "description": "The port number for the MCP server"
        },
        "vscode-mcp-server.host": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Host address for the MCP server"
        },
        "vscode-mcp-server.defaultEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Whether the MCP server should be enabled by default on VS Code startup"
        },
        "vscode-mcp-server.enabledTools": {
          "type": "object",
          "default": {
            "file": true,
            "edit": true,
            "shell": true,
            "diagnostics": true,
            "symbol": true,
            "tasks": true,
            "git": true,
            "terminal": true,
            "refactoring": true,
            "debug": false,
            "config": true,
            "extensions": true,
            "clipboard": true
          },
          "properties": {
            "file": {
              "type": "boolean",
              "description": "Enable file operations tools (read, write, list files)"
            },
            "edit": {
              "type": "boolean",
              "description": "Enable file editing tools (create, edit, delete files)"
            },
            "shell": {
              "type": "boolean",
              "description": "Enable shell command execution tools"
            },
            "diagnostics": {
              "type": "boolean",
              "description": "Enable VS Code diagnostics tools"
            },
            "symbol": {
              "type": "boolean",
              "description": "Enable code symbol and structure analysis tools"
            },
            "tasks": {
              "type": "boolean",
              "description": "Enable VS Code task runner tools (run, stop, read output)"
            },
            "git": {
              "type": "boolean",
              "description": "Enable Git operations tools (status, diff, commit, branch)"
            },
            "terminal": {
              "type": "boolean",
              "description": "Enable advanced terminal management tools"
            },
            "refactoring": {
              "type": "boolean",
              "description": "Enable code refactoring tools (rename, format, organize imports)"
            },
            "debug": {
              "type": "boolean",
              "description": "Enable debug adapter tools (breakpoints, evaluate). Defaults to false to avoid interfering with active debug sessions."
            },
            "config": {
              "type": "boolean",
              "description": "Enable workspace configuration read/write tools"
            },
            "extensions": {
              "type": "boolean",
              "description": "Enable VS Code extensions management tools"
            },
            "clipboard": {
              "type": "boolean",
              "description": "Enable clipboard read/write tools"
            }
          },
          "description": "Configure which MCP tools are enabled"
        }
      }
    },
    "commands": [
      {
        "command": "vscode-mcp-server.showServerInfo",
        "title": "MCP Server Plus: Show Server Information"
      },
      {
        "command": "vscode-mcp-server.toggleServer",
        "title": "MCP Server Plus: Toggle Server"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "github:modelcontextprotocol/inspector",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/proxyquire": "^1.3.28",
    "@types/sinon": "^10.0.13",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^3.6.0",
    "eslint": "^9.23.0",
    "proxyquire": "^2.1.3",
    "sinon": "^16.1.1",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.1",
    "@types/express": "^4.17.21",
    "express": "^4.18.3",
    "zod": "^3.22.4"
  }
}
